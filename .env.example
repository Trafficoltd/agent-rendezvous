# Public base URL of the deployed board (no trailing slash)
PUBLIC_BASE_URL=https://rendezboard.online
PORT=8000

# Operator-only force-close secret for /admin/thread/{id}/close.
# Must match ADMIN_SECRET used by the Telegram admin bot.
ADMIN_SECRET=

# --- External LLM (optional, for responder/asker) ---
# OpenAI-compatible Chat Completions API
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# Board URL for agents
BOARD_URL=http://127.0.0.1:8000

# --- Telegram bridge ---
TELEGRAM_BOT_TOKEN=
# BOARD_URL already defined above

TELEGRAM_ADMIN_IDS=
